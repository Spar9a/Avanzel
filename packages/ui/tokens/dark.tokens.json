  "hud": {
    "$type": "color",
    "surface": {
      "$value": "{palette.hud.glass}"
    },
    "surface-solid": {
      "$value": "{palette.hud.solid}"
    },
    "ink": {
      "$value": "{palette.hud.ink}"
    },
    "ink-secondary": {
      "$value": "{palette.hud.muted}"
    },
    "fill": {
      "$value": "{palette.alpha.white-12}"
    },
    "line": {
      "$value": "{palette.alpha.white-14}"
    },
    "ink-accent": {
      "$value": "{palette.violet.wave}"
    },
    "ink-danger": {
      "$value": "{palette.system.red-text-hud}"
    },
    "ink-ok": {
      "$value": "{palette.system.green-text-dark}"
    },
    "focus": {
      "$value": "{palette.violet.stamp-light}"
    }
  },
  "shadow": {
    "$type": "shadow",
    "window": {
      "$value": [
        {
          "color": "#FFFFFF1F",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0.5px"
        },
        {
          "color": "#000000BF",
          "offsetX": "0px",
          "offsetY": "18px",
          "blur": "44px",
          "spread": "-18px"
        }
      ]
    },
    "card": {
      "$value": [
        {
          "color": "#FFFFFF0F",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0.5px"
        },
        {
          "color": "#000000B3",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "26px",
          "spread": "-12px"
        }
      ]
    },
    "hud": {
      "$value": [
        {
          "color": "#0000008C",
          "offsetX": "0px",
          "offsetY": "14px",
          "blur": "34px",
          "spread": "-12px"
        },
        {
          "color": "#FFFFFF24",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0.5px",
          "inset": true
        }
      ]
    },
    "button": {
      "$value": {
        "color": "#00000066",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "knob": {
      "$value": {
        "color": "#0000004D",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    }
  }
