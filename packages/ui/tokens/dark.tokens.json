    "paper": {
      "$value": "{palette.paper.night}"
    },
    "control": {
      "$value": "{palette.alpha.white-14}"
    },
    "fill": {
      "$value": "{palette.alpha.white-7}"
    },
    "raised": {
      "$value": "{palette.window.dark}"
    },
    "knob": {
      "$value": "{palette.alpha.white}"
    },
    "group": {
      "$value": "{palette.alpha.white-6}"
