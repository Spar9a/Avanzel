{
  "name": "avanzel",
  "private": true,
  "description": "Voice-first second brain that runs on the AI agent you already have.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run dist -w @avanzel/mac",
    "design:check": "node packages/ui/checks/design-check.mjs",
    "ui:tokens": "npm run tokens -w @avanzel/ui",
    "ui:gallery": "npm run gallery -w @avanzel/ui",
    "ui:e2e": "npm run e2e -w @avanzel/ui",
    "ui:approve": "npm run approve -w @avanzel/ui"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true,
    "electron-winstaller": false
  }
}
